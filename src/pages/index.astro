---
import Layout from "../layouts/Layout.astro";

const email = "[email protected]";
const location = "Oxford, UK";
// you can delete heroPath here if it exists
const cvPath = "/noahallwicher-cv/cv.pdf";


/*
// hello #image01
//const heroPath = "/noahallwicher-cv/header.jpg";
*/
---


<div class="page-bottom-spacer"></div>
</main>


  <!-- THEME TOGGLE SCRIPT -->
  <script>
    if (typeof window !== "undefined") {
      const root = document.documentElement;
      const btn = document.getElementById("theme-toggle");

      const getPreferred = () => {
        const stored = window.localStorage.getItem("theme");
        if (stored === "light" || stored === "dark") return stored;
        return window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: light)").matches
          ? "light"
          : "dark";
      };

      const applyTheme = (theme) => {
        root.dataset.theme = theme;
        window.localStorage.setItem("theme", theme);
        if (btn) {
          btn.textContent = theme === "dark" ? "☾" : "☼";
          btn.setAttribute(
            "aria-label",
            theme === "dark" ? "Switch to light mode" : "Switch to dark mode"
          );
        }
      };

      applyTheme(getPreferred());

      btn?.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        applyTheme(next);
      });
    }
  </script>

  <style>
    :global(:root) {
      --bg: #0b0b10;
      --fg: #f5f5f5;
      --muted: #a0a0b5;
      --accent: #9ad0ff;
      --border-subtle: #2a2a3a;
      --card-bg: rgba(20, 20, 30, 0.9);
    }

    :global(:root[data-theme="light"]) {
      --bg: #ffffff;
      --fg: #111111;
      --muted: #555555;
      --accent: #0056b3;
      --border-subtle: #dddddd;
      --card-bg: #f9f9fb;
    }

    :global(body) {
      margin: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text",
        "Helvetica Neue", Arial, sans-serif;
      background: var(--bg);
      color: var(--fg);
      transition: background 0.2s ease, color 0.2s ease;
    }

	/* Default (light mode) header image */
	
	.hero-banner {
	width: 100%;
	height: 600px; 
	background-image: url("/noahallwicher-cv/image01 2.jpg");
	background-size: cover;
	background-position: center;
	background-repeat: no-repeat;
	background-color: #000;
	}


	/* Dark mode header image */
	:global(:root[data-theme="dark"]) .hero-banner {
	background-image: url("/noahallwicher-cv/image01.jpg");
	}


    .page {
      max-width: 900px;
      margin: 0 auto;
      padding: 3rem 1.5rem 3rem;
    }

    .hero {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 1.5rem;
      align-items: baseline;
      margin-bottom: 2.5rem;
      border-bottom: 1px solid var(--border-subtle);
      padding-bottom: 1.5rem;
    }

    h1 {
      font-size: 2.4rem;
      margin: 0 0 0.25rem;
    }

    .tagline {
      margin: 0;
      font-size: 1.1rem;
      color: var(--muted);
    }

    .contact {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      font-size: 0.95rem;
      text-align: right;
    }

    .contact a {
      color: var(--accent);
      text-decoration: none;
    }

    .contact a:hover {
      text-decoration: underline;
    }

    .section {
      margin-top: 2.5rem;
    }

    .section h2 {
      font-size: 1.5rem;
      margin-bottom: 1rem;
      border-bottom: 1px solid var(--border-subtle);
      padding-bottom: 0.4rem;
    }

    .entry {
      display: grid;
      grid-template-columns: minmax(0, 5.5fr) minmax(0, 1fr); /* left / right */
      grid-template-rows: auto auto;                        /* header row, content row */
      column-gap: 2rem;
      row-gap: 0;
      margin-bottom: 1.6rem;
      align-items: flex-start;
    }

    .entry-heading {
      grid-column: 1 / 2;
      grid-row: 1 / 2;
      font-size: 1.05rem;
      font-weight: 600;
    }

    .entry-dates {
      grid-column: 2 / 3;
      grid-row: 1 / 2;
      text-align: right;
      font-size: 0.9rem;
      white-space: nowrap;
      color: var(--muted);
    }

    .entry-points {
      grid-column: 1 / 2;
      grid-row: 2 / 3;
      margin: 0;
      padding-left: 1.2rem;
      font-size: 0.95rem;
      line-height: 1.4;
    }

    .entry-location {
      grid-column: 2 / 3;
      grid-row: 2 / 3;
      text-align: right;
      font-size: 0.9rem;
      font-weight: 600;
      margin-top: 0;
    }

    ul {
      margin: 0;
    }

    .theme-toggle {
      position: fixed;
      top: 1.2rem;
      right: 1.2rem;
      padding: 0.25rem 0.55rem;
      font-size: 0.85rem;
      border-radius: 999px;
      border: 1px solid var(--border-subtle);
      background: rgba(10, 10, 15, 0.9);
      color: var(--fg);
      cursor: pointer;
      z-index: 1000;
    }

    :global(:root[data-theme="light"]) .theme-toggle {
      background: rgba(255, 255, 255, 0.9);
    }

    .theme-toggle:hover {
      border-color: var(--accent);
    }

    .print-wrapper {
      margin-top: 3rem;
      display: flex;
      justify-content: center;
    }

    .print-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid #555;
      background: transparent;
      border-radius: 999px;
      width: 2.4rem;
      height: 2.4rem;
      font-size: 1.2rem;
      text-decoration: none;
      color: inherit;
      cursor: pointer;
    }

    .print-button:hover {
      border-color: #000;
    }

    .page-bottom-spacer {
      height: 4rem;
    }

    @media (max-width: 700px) {
      .entry {
        grid-template-columns: 1fr;
      }

      .entry-dates,
      .entry-location {
        grid-column: 1 / 2;
        text-align: left;
        white-space: normal;
      }

      .contact {
        text-align: left;
        align-items: flex-start;
      }
    }

    @media print {
      .theme-toggle,
      .print-wrapper,
      .page-bottom-spacer {
        display: none;
      }
    }
  </style>
</Layout>
